#: plugins/cli_control/templates/cli_control_help.html:15 plugins/cli_control/templates/cli_control_help.html:22
msgid "Switching ON the station without time limitation (the sensor relay remains closed until a switch-off command arrives)."
msgstr "Einschalten der Station ohne zeitliche Begrenzung (das Sensorrelais bleibt geschlossen, bis ein Ausschaltbefehl eintrifft)."

#: plugins/cli_control/templates/cli_control_help.html:16
msgid "curl --data \"re=1\" \"http://10.10.10.34:80/0123456789abcdef\""
msgstr "curl --data \"re=1\" \"http://10.10.10.34:80/0123456789abcdef\""

#: plugins/cli_control/templates/cli_control_help.html:17 plugins/cli_control/templates/cli_control_help.html:24
msgid "Switching ON the station with time limitation (the sensor relay switches off after this time regardless of whether a switch-off command arrives)."
msgstr "Zeitbegrenztes Einschalten der Station (das Sensorrelais schaltet nach dieser Zeit ab, unabhängig davon, ob ein Ausschaltbefehl eintrifft)."

