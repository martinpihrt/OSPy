"{\"station\": 4, \"status\": \"off\", \"name\": \"Station 05\", \"reason\": "
"\"\"}, {\"station\": 5, \"status\": \"off\", \"name\": \"Station 06\", "
"\"reason\": \"\"}, {\"station\": 6, \"status\": \"off\", \"name\": \"Station "
"07\", \"reason\": \"\"}, {\"station\": 7, \"status\": \"off\", \"name\": "
"\"Station 08\", \"reason\": \"\"}]"
msgstr ""
"Beispiel einer ausgehenden Nachricht (Haupt-OSPy): [{\"station\": 0, \"status"
"\": \"off\", \"name\": \"Station 01\", \"reason\": \"\"}, {\"station\": 1, "
"\"status\": \"off\", \"name\": \"Station 02\", \"reason\": \"\"}, {\"station"
