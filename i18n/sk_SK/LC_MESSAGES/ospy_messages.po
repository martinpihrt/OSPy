msgstr ""
"1: aspoň raz. Odošle správu aspoň raz, pokiaľ je prijaté potvrdenie alebo je"
" prijatý príkaz na ukončenie prenosu."

#: plugins/mqtt/templates/mqtt_help.html:90
msgid "2: exactly once. Will only send a message once."
msgstr "2: presne raz. Správu pošle iba raz."

