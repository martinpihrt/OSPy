msgid "BLUE"
msgstr "MODRÁ"

#: plugins/chmi/templates/chmi.html:365
msgid "Use blue channel for rain detection."
msgstr "Použite modrý kanál na detekciu dažďa."

#: plugins/chmi/templates/chmi.html:375
msgid "Detection radius"
msgstr "Detekčný polomer"

#: plugins/chmi/templates/chmi.html:376
msgid ""
"Pixel radius around my location used for rain detection. A larger radius is "
"less sensitive to one bad pixel."
msgstr ""
"Pixelový polomer okolo mojej polohy používaný na detekciu dažďa. Väčší "
"polomer je menej citlivý na jeden zlý pixel."

#: plugins/chmi/templates/chmi.html:381
msgid "Minimum rainy pixels"
msgstr "Minimálne daždivé pixely"

#: plugins/chmi/templates/chmi.html:382
msgid ""
"Minimum percentage of pixels in the detection area that must exceed the "
"intensity threshold before rain delay is activated."
msgstr ""
"Minimálne percento pixelov v detekčnej oblasti, ktoré musia prekročiť prah "
"intenzity pred aktiváciou oneskorenia dažďa."

