#: ospy/webpages.py:3861
msgid "Sensor reports do not require authentication."
msgstr "Извештаји сензора не захтевају аутентификацију."

#: ospy/webpages.py:3861
msgid "Sensor reports require authentication."
msgstr "Извештаји сензора захтевају потврду аутентичности."

#: ospy/webpages.py:3862
msgid "Only authenticated sensor clients may submit measurements."
msgstr "Само проверени клијенти сензора могу да поднесу мерења."

#: ospy/webpages.py:3863
msgid "Legacy sensor firmware may submit measurements without credentials."
msgstr "Застарели фирмвер сензора може да пошаље мерења без акредитива."

#: ospy/webpages.py:3864
msgid "Enable sensor API authentication after confirming that every sensor supports credentials."
msgstr "Омогућите АПИ аутентификацију сензора након што потврдите да сваки сензор подржава акредитиве."

#: ospy/webpages.py:3870
msgid "API CSRF protection"
msgstr "АПИ ЦСРФ заштита"

#: ospy/webpages.py:3873
#| msgid "Voice Station is disabled."
msgid "API CSRF protection is disabled."
msgstr "АПИ ЦСРФ заштита је онемогућена."

#: ospy/webpages.py:3873
msgid "State-changing API requests require a CSRF token."
msgstr "АПИ захтеви за промену стања захтевају ЦСРФ токен."

#: ospy/webpages.py:3874
msgid "Browser-based API clients must provide the OSPy CSRF token."
msgstr "АПИ клијенти засновани на претраживачу морају да обезбеде ОСПи ЦСРФ токен."

#: ospy/webpages.py:3875
msgid "Older API integrations may change OSPy state without a CSRF token."
msgstr "Старије АПИ интеграције могу да промене стање ОСПи-а без ЦСРФ токена."

#: ospy/webpages.py:3876
msgid "Enable API CSRF protection after updating integrations that change OSPy state."
msgstr "Омогућите АПИ ЦСРФ заштиту након ажурирања интеграција које мењају ОСПи стање."

#: ospy/webpages.py:3885
#| msgid "API CORS allowed origin"
msgid "API CORS allows every browser origin."
msgstr "АПИ ЦОРС дозвољава свако порекло претраживача."

#: ospy/webpages.py:3886
msgid "Any web page may read permitted OSPy API responses from a browser."
msgstr "Свака веб страница може да чита дозвољене ОСПи АПИ одговоре из прегледача."

#: ospy/webpages.py:3888
#| msgid "Scheduler is now disabled"
msgid "API CORS headers are disabled."
msgstr "АПИ ЦОРС заглавља су онемогућена."

#: ospy/webpages.py:3889
