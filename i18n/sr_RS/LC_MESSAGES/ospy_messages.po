#: back_door.py:17
msgid "WARNING: This local recovery script resets the OSPy administrator login."
msgstr "УПОЗОРЕЊЕ: Ова локална скрипта за опоравак ресетује ОСПи администраторску пријаву."

#: back_door.py:18
msgid "Run it only from the Raspberry Pi console or another trusted local shell."
msgstr "Покрените га само са Распберри Пи конзоле или друге поуздане локалне љуске."

#: back_door.py:28
#| msgid "Password for access"
msgid "Password reset cancelled."
msgstr "Ресетовање лозинке је отказано."

#: back_door.py:72
