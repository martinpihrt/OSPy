#| msgid "Weather - No location found!"
msgid "Weather location mode"
msgstr "Режим временске локације"

#: ospy/options.py:276
#| msgid "Selected master station:"
msgid "Detected weather country code"
msgstr "Детектована временска шифра земље"

#: ospy/options.py:281
#| msgid "Selected master station:"
msgid "Detected weather region"
msgstr "Пронађена временска регија"

#: ospy/options.py:286
msgid "Holiday country override"
msgstr "Земља празника оверриде"

#: ospy/options.py:288
msgid ""
"Optional two-letter country code used for public holidays. Leave empty to use the country "
"detected from the weather location."
msgstr "Опциони двословни код земље који се користи за државне празнике. Оставите празно да бисте користили земљу откривену са временске локације."

#: ospy/options.py:293
#| msgid "Programs changed"
msgid "Program service outages"
msgstr "Прекиди услуге програма"

#: ospy/options.py:300
msgid "Disable security"
msgstr "Онемогућите безбедност"

#: ospy/options.py:302
msgid "Allow anonymous users to access the system without a password."
msgstr "Дозволите анонимним корисницима приступ систему без лозинке."

#: ospy/options.py:303 ospy/options.py:310 ospy/templates/options.html:167
#: ospy/templates/options.html:178 ospy/templates/users.html:3 ospy/templates/users.html:28
msgid "Users"
msgstr "Корисници"

#: ospy/options.py:307
msgid "Administrator name"
msgstr "Име администратора"

#: ospy/options.py:309
msgid "Administrator login name for login to the OSPy."
msgstr "Име за пријаву администратора за пријаву на ОСПи."

#: ospy/options.py:314
msgid "Two-factor authentication method"
msgstr "Двофакторска метода аутентификације"

#: ospy/options.py:319
msgid "Two-factor authentication secret"
msgstr "Тајна аутентификације са два фактора"

#: ospy/options.py:324
msgid "Two-factor backup codes"
msgstr "Двофакторни резервни кодови"

#: ospy/options.py:331
msgid "Use HTTPS access"
msgstr "Користите приступ HTTPS"

#: ospy/options.py:333
msgid ""
"Read HELP/Web Interface Guide. SSL certificate via Lets Encrypt certification authority "
"(effective after reboot.)"
msgstr ""
"Прочитајте HELP/Водич за веб интерфејс. SSL сертификат преко овлашћења за сертификацију Летс "
"Енцрипт (на снази након поновног покретања.)"

#: ospy/options.py:334 ospy/options.py:341 ospy/options.py:348 ospy/options.py:355
#: ospy/options.py:362 ospy/options.py:369 ospy/options.py:376 ospy/options.py:383
#: ospy/templates/options.html:167 ospy/templates/options.html:179
msgid "Security"
msgstr "Безбедност"

#: ospy/options.py:338
msgid "Domain name"
msgstr "Име домена"

#: ospy/options.py:340
msgid ""
"Domain name for generating SSL certificate via Lets Encrypt certification authority. Example: "
"home.sprinkler.com"
msgstr ""
"Име домена за генерисање сертификата SSL преко ауторитета за сертификацију Летс Енцрипт. Пример: "
"хоме.спринклер.цом"

#: ospy/options.py:345
msgid "Use Own HTTPS access"
msgstr "Користите сопствени приступ HTTPS"

#: ospy/options.py:347
msgid "SSL certificate via own file without certification authority (effective after reboot.)"
msgstr ""
"SSL сертификат преко сопствене датотеке без овлашћења за сертификацију (на снази након поновног "
"покретања.)"

#: ospy/options.py:352
msgid "API CORS allowed origin"
msgstr "АПИ ЦОРС дозвољено порекло"

#: ospy/options.py:354
msgid ""
"Allowed browser origin for API CORS requests. Use * to allow any origin, enter one origin such "
"as https://example.com, enter multiple origins separated by commas, or leave empty to disable "
"CORS headers. This affects browser-based API clients only."
msgstr ""
"Дозвољено порекло претраживача за АПИ ЦОРС захтеве. Користите * да дозволите било које порекло, "
"унесите једно порекло као што је хттпс://еxампле.цом, унесите више извора одвојених зарезима, "
"или оставите празно да бисте онемогућили ЦОРС заглавља. Ово утиче само на АПИ клијенте засноване "
"на претраживачу."

#: ospy/options.py:359
msgid "Enable API JSONP"
msgstr "Омогућите АПИ ЈСОНП"

#: ospy/options.py:361
msgid ""
"Allow legacy API JSONP responses via the callback query parameter. Keep disabled unless an old "
"integration requires JSONP, because normal API clients should use JSON with CORS instead."
msgstr ""
"Дозволите наслеђе АПИ ЈСОНП одговоре преко параметра упита за повратни позив. Држите "
"онемогућено, осим ако стара интеграција не захтева ЈСОНП, јер нормални АПИ клијенти треба да "
"користе ЈСОН са ЦОРС-ом уместо тога."

#: ospy/options.py:366
#| msgid "Rain sensor default."
msgid "Require sensor API auth"
msgstr "Захтевај потврду за АПИ сензора"

#: ospy/options.py:368
msgid ""
"Require HTTP Basic authentication for sensor reports sent to /api/sensor. Keep disabled for "
"older sensor firmware that cannot send credentials."
msgstr "Захтевај ХТТП основну аутентификацију за извештаје сензора који се шаљу на /апи/сенсор. Нека буде онемогућено за старији фирмвер сензора који не може да пошаље акредитиве."

#: ospy/options.py:373
msgid "Require API CSRF token"
msgstr "Захтевај АПИ ЦСРФ токен"

#: ospy/options.py:375
msgid ""
"Require a CSRF token for state-changing API requests. Keep disabled for older integrations that "
"use only HTTP Basic authentication."
msgstr "Захтевајте ЦСРФ токен за АПИ захтеве за промену стања. Нека буде онемогућено за старије интеграције које користе само ХТТП Басиц аутентификацију."

#: ospy/options.py:380
#| msgid "Maximum usage"
msgid "Maximum upload size"
msgstr "Максимална величина за отпремање"

#: ospy/options.py:382
msgid ""
"Maximum uploaded file size in MB for backup restore, SSL files, station images, and custom "
"sensor firmware. Use 0 for no application limit."
msgstr "Максимална величина отпремљене датотеке у МБ за враћање резервне копије, ССЛ датотеке, слике станица и прилагођени фирмвер сензора. Користите 0 без ограничења апликације."

#: ospy/options.py:391
msgid "Password FW"
msgstr "Пассворд ФВ"

#: ospy/options.py:393
msgid ""
"Password for uploading firmware from OSPy to sensor (for all used sensors - the same password "
"must be used in sensor options.)"
msgstr ""
"Лозинка за учитавање фирмвера са ОСПи на сензор (за све коришћене сензоре - иста лозинка мора да "
"се користи у опцијама сензора.)"

#: ospy/options.py:394 ospy/options.py:401 ospy/templates/base.html:436
#: ospy/templates/options.html:180 ospy/webpages.py:4301
#: plugins/cli_control/templates/cli_control_help.html:12
#: plugins/email_notifications/__init__.py:237 plugins/email_notifications/__init__.py:238
#: plugins/email_notifications_ssl/__init__.py:341 plugins/email_notifications_ssl/__init__.py:342
#: plugins/lcd_display/templates/lcd_display.html:372
#: plugins/lcd_display/templates/lcd_display_help.html:48
msgid "Sensors"
msgstr "Сензори"

#: ospy/options.py:398
#| msgid "DS18B20 error timeout"
msgid "Sensor HTTP timeout"
msgstr "ХТТП временско ограничење сензора"

#: ospy/options.py:400
msgid "Timeout in seconds for HTTP requests sent from OSPy to sensors."
msgstr "Временско ограничење у секундама за ХТТП захтеве послате од ОСПи до сензора."

#: ospy/options.py:409
msgid "Maximum usage"
msgstr "Максимална употреба"

#: ospy/options.py:411
msgid ""
"Determines how station runs are combined. 0 means no limit. 1 means one station at a time when "
"each station has usage 1. This also affects when the pause between stations is inserted."
msgstr ""
"Одређује како се комбинују станичне стазе. 0 значи без ограничења. 1 значи једну станицу у исто "
"време када свака станица има употребу 1. Ово такође утиче на то када је убачена пауза између "
"станица."

#: ospy/options.py:412 ospy/options.py:419 ospy/options.py:428 ospy/options.py:437
msgid "Station Handling"
msgstr "Руковање станицама"

#: ospy/options.py:416
msgid "Number of outputs"
msgstr "Број излаза"

#: ospy/options.py:418
msgid "The number of outputs available (8 + 8*extensions)"
msgstr "Број доступних излаза (8 + 8* екстензија)"

#: ospy/options.py:425
msgid "Pause between stations"
msgstr "Pauza izme?u stanica"

#: ospy/options.py:427
msgid ""
"Pause inserted between sequential station runs when the scheduler cannot run them at the same "
"time, in seconds between 0 and 3600. This does not shift a station against the master station. "
"Example: with maximum usage 1 and station usage 1, value 30 starts the next station 30 seconds "
"after the previous station ends."
msgstr ""
"Пауза убачена између секвенцијалне станице ради када планер не може да их покрене у исто време, "
"у секундама између 0 и 3600. Ово не помера станицу против главне станице. Пример : са "
"максималном употребом 1 и употребом станице 1, вредност 30 покреће следећу станицу 30 секунди "
"након завршетка претходне станице."

#: ospy/options.py:434
msgid "Minimum runtime"
msgstr "Минимално време рада"

#: ospy/options.py:436
msgid ""
"Skip the pause between stations when the previous run was shorter than this value, in seconds "
"between 0 and 86400. Example: with pause 30 and minimum runtime 10, a station that ran only 5 "
"seconds will not force the 30 second pause."
msgstr ""
"Прескочите паузу између станица када је претходна вожња била краћа од ове вредности, у секундама "
"између 0 и 86400. Пример : са паузом 30 и минималним временом извођења 10, станица која је "
"радила само 5 секунди неће присилити паузу од 30 секунди."

#: ospy/options.py:445
msgid "Activate relay"
msgstr "Активирајте релеј"

#: ospy/options.py:447
msgid "Also activate the relay as master output."
msgstr "Такође активирајте релеј као главни излаз."

#: ospy/options.py:448 ospy/options.py:455 ospy/options.py:464 ospy/options.py:473
#: ospy/options.py:482
msgid "Configure Master"
msgstr "Цонфигуре Мастер"

#: ospy/options.py:452
msgid "Master start offset"
msgstr "Pomeranje starta glavne stanice"

#: ospy/options.py:454
msgid ""
"Time offset for starting master station 1 relative to the station start, in seconds between "
"-1800 and +1800. Negative values start the master earlier; positive values start it later. "
"Example: -10 starts the master 10 seconds before the station, +10 starts it 10 seconds after the "
"station."
msgstr ""
"Временски офсет за покретање мастер станице 1 у односу на почетак станице, у секундама између "
"-1800 и + 1800. Негативне вредности почињу мастер раније; Позитивне вредности почињу касније. "
"Пример : -10 покреће мастер 10 секунди пре станице, + 10 га покреће 10 секунди након станице."

#: ospy/options.py:461
msgid "Master stop offset"
msgstr "Pomeranje isklju?ivanja glavne stanice"

#: ospy/options.py:463
msgid ""
"Time offset for stopping master station 1 relative to the station end, in seconds between -1800 "
"and +1800. Negative values stop the master earlier; positive values keep it running longer. "
"Example: -5 stops the master 5 seconds before the station ends, +20 stops it 20 seconds after "
"the station ends."
msgstr ""
"Временски офсет за заустављање мастер станице 1 у односу на крај станице, у секундама између "
"-1800 и + 1800. Негативне вредности раније заустављају мастер; позитивне вредности одржавају га "
"дуже. Пример : -5 зауставља мастер 5 секунди пре краја станице, + 20 га зауставља 20 секунди "
"након завршетка станице."

#: ospy/options.py:470
msgid "Master two start offset"
msgstr "Pomeranje starta glavne stanice 2"

#: ospy/options.py:472
msgid ""
"Time offset for starting master station 2 relative to the station start, in seconds between "
"-1800 and +1800. Negative values start the master earlier; positive values start it later. "
"Example: -10 starts master 2 10 seconds before the station, +10 starts it 10 seconds after the "
"station."
msgstr ""
"Временски офсет за покретање мастер станице 2 у односу на почетак станице, у секундама између "
"-1800 и + 1800. Негативне вредности почињу мастер раније; Позитивне вредности почињу касније. "
"Пример : -10 почиње мастер 2 10 секунди пре станице, + 10 га покреће 10 секунди након станице."

#: ospy/options.py:479
msgid "Master two stop offset"
msgstr "Pomeranie isklju?ivanja glavne stanice 2"

#: ospy/options.py:481
msgid ""
"Time offset for stopping master station 2 relative to the station end, in seconds between -1800 "
"and +1800. Negative values stop the master earlier; positive values keep it running longer. "
"Example: -5 stops master 2 5 seconds before the station ends, +20 stops it 20 seconds after the "
"station ends."
msgstr ""
"Временски офсет за заустављање мастер станице 2 у односу на крај станице, у секундама између "
"-1800 и + 1800. Негативне вредности раније заустављају мастер; позитивне вредности одржавају га "
"дуже. Пример : -КСНУМКС зауставља мастер КСНУМКС КСНУМКС секунди пре завршетка станице, + "
"КСНУМКС га зауставља КСНУМКС секунди након завршетка станице."

#: ospy/options.py:490
msgid "Use rain sensor"
msgstr "Користите сензор за кишу"

#: ospy/options.py:492
msgid "Use rain sensor."
msgstr "Користите сензор за кишу."

#: ospy/options.py:493 ospy/options.py:500 ospy/options.py:507 ospy/options.py:514
#: plugins/lcd_display/templates/lcd_display.html:300
#: plugins/lcd_display/templates/lcd_display_help.html:40
msgid "Rain Sensor"
msgstr "Раин Сенсор"

#: ospy/options.py:497 plugins/pressure_monitor/templates/pressure_monitor.html:337
msgid "Normally open"
msgstr "Нормално отворен"

#: ospy/options.py:499
msgid "Rain sensor default."
msgstr "Подразумевано сензор за кишу."

#: ospy/options.py:504
msgid "Set rain delay"
msgstr "Подесите одлагање кише"

#: ospy/options.py:506
msgid ""
"When the rain sensor is activated, the rain delay is set (this is suitable, for example, for "
"blocking programs for a longer time than provided by the rain sensor)."
msgstr ""
"Када је сензор за кишу активиран, поставља се кашњење за кишу (ово је погодно, на пример, за "
"блокирање програма на дуже време него што је предвиђено сензором за кишу)."

#: ospy/options.py:511
msgid "Rain delay time"
msgstr "Време одлагања кише"

#: ospy/options.py:513
msgid "Rain delay time (in hours), between 0 and 500."
msgstr "Време кашњења кише (у сатима), између 0 и 500."

#: ospy/options.py:522
#| msgid "Show data from sensors on home page."
msgid "Show diagnostic errors on the home page"
msgstr "Прикажи дијагностичке грешке на почетној страници"

#: ospy/options.py:524
msgid ""
"Show a red diagnostic error window to administrators on the home page. Diagnostic errors have "
"priority over update notifications."
msgstr "Прикажи црвени прозор дијагностичке грешке администраторима на почетној страници. Дијагностичке грешке имају приоритет над обавештењима о ажурирању."

#: ospy/options.py:525 ospy/templates/base.html:473 ospy/templates/diagnostics.html:3
#: ospy/templates/diagnostics.html:1097 ospy/templates/diagnostics.html:1166
#: ospy/templates/options.html:177
msgid "Diagnostics"
msgstr "Дијагностика"

#: ospy/options.py:531
msgid "Enable run log"
msgstr "Омогући евиденцију покретања"

#: ospy/options.py:533
msgid "Log all runs - note that repetitive writing to an SD card can shorten its lifespan."
msgstr ""
"Забележите све радње - имајте на уму да понављање писања на СД картицу може да скрати њен "
"животни век."

#: ospy/options.py:534 ospy/options.py:541 ospy/options.py:550 ospy/options.py:557
#: ospy/options.py:566 ospy/options.py:573 ospy/options.py:582 ospy/options.py:591
#: ospy/options.py:598 ospy/templates/log.html:114 ospy/templates/log.html:156
#: ospy/templates/log.html:191 ospy/templates/log_user.html:18 ospy/templates/log_user.html:47
#: ospy/templates/log_user.html:77
msgid "Logging"
msgstr "Логгинг"

#: ospy/options.py:538
msgid "Max run entries"
msgstr "Максимални број уноса"

#: ospy/options.py:540
msgid "Number of run entries to save to disk, 0=no limit."
msgstr "Број уноса за покретање за чување на диску, 0=без ограничења."

#: ospy/options.py:547
msgid "Enable email log"
msgstr "Омогућите евиденцију е-поште"

#: ospy/options.py:549
msgid "Log all emails - note that repetitive writing to an SD card can shorten its lifespan."
msgstr ""
"Евидентирајте све е-поруке - имајте на уму да понављање писања на СД картицу може скратити њен "
"животни век."

#: ospy/options.py:554
msgid "Max email entries"
msgstr "Максималан број уноса е-поште"

#: ospy/options.py:556
msgid "Number of email entries to save to disk, 0=no limit."
msgstr "Број уноса е-поште за чување на диску, 0=без ограничења."

#: ospy/options.py:563
msgid "Enable events log"
msgstr "Омогући евиденцију догађаја"

#: ospy/options.py:565
msgid "Log all events - note that repetitive writing to an SD card can shorten its lifespan."
msgstr ""
"Забележите све догађаје - имајте на уму да понављање писања на СД картицу може скратити њен "
"животни век."

#: ospy/options.py:570
msgid "Max events entries"
msgstr "Максимални унос догађаја"

#: ospy/options.py:572
msgid "Number of events entries to save to disk, 0=no limit."
msgstr "Број уноса догађаја за чување на диску, 0=без ограничења."

#: ospy/options.py:579
msgid "Max sensor entries"
msgstr "Максимални уноси сензора"

#: ospy/options.py:581
msgid "Number of sensor entries to save to disk, 0=no limit."
msgstr "Број уноса сензора за чување на диску, 0=без ограничења."

#: ospy/options.py:588
msgid "Enable debug log"
msgstr "Омогући евиденцију отклањања грешака"

#: ospy/options.py:590
msgid "Log all internal events (for debugging purposes)."
msgstr "Забележите све интерне догађаје (у сврху отклањања грешака)."

#: ospy/options.py:595
msgid "Enable web log"
msgstr "Омогући веб дневник"

#: ospy/options.py:597
msgid ""
"Logging of internal events from the web server (for debugging it is necessary to enable the "
"debug log and then restart OSPy). Deteriorates page loading speed."
msgstr ""
"Евидентирање интерних догађаја са веб сервера (за отклањање грешака потребно је омогућити "
"евиденцију отклањања грешака и затим поново покренути ОСПи). Смањује брзину учитавања странице."

#: ospy/options.py:604
msgid "Shift register speed"
msgstr "Брзина регистра померања"

#: ospy/options.py:606
msgid ""
"This setting controls the clock speed for the shift register (74HC595) that controls the output "
"relay. In some cases, it is advisable to reduce the speed to 10us. If the checkbox is not "
"selected, the default speed is used. Otherwise, the speed will be reduced. (If you have no "
"problems with timing, ignore this option.) False = maximum, clock according to the system "
"(typically 0.5–2 MHz). True = approx. 100 kHz (safe for 74HC595 even with longer cables). "
"Commonly recommended safe speed: around 50–200 kHz, i.e. approximately 5–20 µs delay between "
"clock pulses."
msgstr ""
"Ово подешавање контролише брзину такта за померајући регистар (74ХЦ595) који контролише излазни "
"релеј. У неким случајевима, препоручљиво је смањити брзину на 10ус. Ако поље за потврду није "
"изабрано, користи се подразумевана брзина. У супротном, брзина ће бити смањена. (Ако немате "
"проблема са временом, занемарите ову опцију.) Нетачно = максимум, такт према систему (обично 0,5–"
"2 МХз). Тачно = прибл. 100 кХз (сигурно за 74ХЦ595 чак и са дужим кабловима). Уобичајено "
"препоручена сигурна брзина: око 50–200 кХз, односно око 5–20 µс кашњења између импулса такта."

