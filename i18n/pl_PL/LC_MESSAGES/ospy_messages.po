msgstr "Włącz program"

#: plugins/sunrise_and_sunset/templates/sunrise_and_sunset_setup.html:97
msgid "If the check box is marked, the program will be active."
msgstr "Jeżeli checkbox jest zaznaczony, program będzie aktywny."

#: plugins/sunrise_and_sunset/templates/sunrise_and_sunset_setup.html:106
msgid "If the checkbox is checked, the program will be active even if it is currently raining (rain is ignored)."
msgstr "Jeżeli checkbox jest zaznaczony, program będzie aktywny nawet jeśli aktualnie pada deszcz (deszcz jest ignorowany)."

#: plugins/sunrise_and_sunset/templates/sunrise_and_sunset_setup.html:115
msgid "If the checkbox is checked, the program will be active even if it is currently rain delay (rain delay is ignored)."
msgstr "Jeżeli checkbox jest zaznaczony, program będzie aktywny nawet jeśli aktualnie jest opóźnienie spowodowane deszczem (opóźnienie deszczowe jest ignorowane)."

#: plugins/sunrise_and_sunset/templates/sunrise_and_sunset_setup.html:123
msgid "Program type"
msgstr "Typ programu"

#: plugins/sunrise_and_sunset/templates/sunrise_and_sunset_setup.html:124
