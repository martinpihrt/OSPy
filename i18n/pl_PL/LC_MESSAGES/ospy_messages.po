#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:9
msgid "Weather Dashboard shows selected values from other OSPy plugins and OSPy sensors on one dashboard."
msgstr "Weather Dashboard pokazuje wybrane wartości z innych wtyczek OSPy i czujników OSPy na jednym dashboardzie."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:10
msgid "Each displayed item is configured as one gauge. A gauge can be shown as a round canvas meter or as a simple text value."
msgstr "Każdy wyświetlany element jest skonfigurowany jako jeden miernik. Wskaźnik może być wyświetlany jako okrągły miernik płótna lub jako prosta wartość tekstowa."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:12
msgid "Dashboard modes"
msgstr "Tryby panelu"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:14 plugins/weather_stations/__init__.py:407
msgid "Canvas"
msgstr "Płótno"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:15
msgid "Shows enabled gauges as round meters. Use Canvas size to set the width and height of each meter."
msgstr "Pokazuje włączone wskaźniki jako metry okrągłe. Użyj opcji Rozmiar płótna, aby ustawić szerokość i wysokość każdego metra."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:16 plugins/weather_stations/__init__.py:407
msgid "Text"
msgstr "Tekst"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:17
msgid "Shows enabled gauges as text values. Use Text font to set the size of the displayed text."
msgstr "Pokazuje włączone wskaźniki jako wartości tekstowe. Użyj czcionki tekstowej, aby ustawić rozmiar wyświetlanego tekstu."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:22 plugins/weather_dashboard/templates/weather_dashboard_page.html:209
msgid "Dashboard mode"
msgstr "Tryb deski rozdzielczej"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:23
msgid "Select whether the dashboard page will use canvas meters or text values."
msgstr "Wybierz, czy strona panelu kontrolnego będzie używać mierników kanwy, czy wartości tekstowych."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:24 plugins/weather_dashboard/templates/weather_dashboard_page.html:231
msgid "Canvas size"
msgstr "Rozmiar płótna"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:25
msgid "The number determines the size of the round meter in canvas mode."
msgstr "Liczba określa rozmiar metra okrągłego w trybie płótna."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:26 plugins/weather_dashboard/templates/weather_dashboard_page.html:248
msgid "Text font"
msgstr "Czcionka tekstowa"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:27
msgid "The number determines the font size in text mode."
msgstr "Liczba określa rozmiar czcionki w trybie tekstowym."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:30
msgid "Gauge settings"
msgstr "Ustawienia miernika"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:32 plugins/weather_dashboard/templates/weather_dashboard_page.html:273
msgid "Add Gauge"
msgstr "Dodaj miernik"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:33
msgid "Adds a new gauge with default settings."
msgstr "Dodaje nowy miernik z ustawieniami domyślnymi."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:35
msgid "Removes the selected gauge from the dashboard."
msgstr "Usuwa wybrany wskaźnik z pulpitu nawigacyjnego."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:37
msgid "When checked, this gauge is shown on the dashboard. When unchecked, the gauge is saved but hidden."
msgstr "Po zaznaczeniu wskaźnik ten jest wyświetlany na desce rozdzielczej. Jeśli ta opcja jest odznaczona, miernik zostanie zapisany, ale ukryty."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:39
msgid "The name displayed on the canvas meter or before the text value."
msgstr "Nazwa wyświetlana na mierniku obszaru roboczego lub przed wartością tekstową."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:40 plugins/weather_dashboard/templates/weather_dashboard_page.html:329
msgid "Unit"
msgstr "Jednostka"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:41
msgid "The unit displayed after the value, for example C, %, cm, l, V, or km/h."
msgstr "Jednostka wyświetlana po wartości, na przykład C, %, cm, l, V lub km/h."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:43
msgid "Selects where the value is read from. Available sources are loaded from the plugin source registry."
msgstr "Wybiera miejsce, z którego odczytywana jest wartość. Dostępne źródła są ładowane z rejestru źródeł wtyczek."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:45
msgid "Selects the input channel for the selected source. The list changes automatically after changing Source."
msgstr "Wybiera kanał wejściowy dla wybranego źródła. Lista zmienia się automatycznie po zmianie źródła."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:46 plugins/weather_dashboard/templates/weather_dashboard_page.html:369
msgid "Value type"
msgstr "Typ wartości"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:47
msgid "Selects which value from the selected source is used. The list changes automatically after changing Source."
msgstr "Wybiera, która wartość z wybranego źródła ma być używana. Lista zmienia się automatycznie po zmianie źródła."

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:50
msgid "Scale and colors"
msgstr "Skala i kolory"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:52 plugins/weather_dashboard/templates/weather_dashboard_page.html:388
msgid "Ticks"
msgstr "Kleszcze"

#: plugins/weather_dashboard/templates/weather_dashboard_help_page.html:53
msgid "Comma separated scale labels used by the canvas meter, for example 0,25,50,75,100."
msgstr "Etykiety skali oddzielone przecinkami używane przez miernik płótna, na przykład 0,25,50,75,100."

