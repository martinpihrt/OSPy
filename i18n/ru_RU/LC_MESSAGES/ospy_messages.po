#: plugins/mqtt_home_assistant/__init__.py:1345
msgid "Cannot update data from plugins."
msgstr "Невозможно обновить данные из плагинов."

#: plugins/mqtt_home_assistant/templates/mqtt_home_assistant.html:3
#: plugins/mqtt_home_assistant/templates/mqtt_home_assistant.html:113
