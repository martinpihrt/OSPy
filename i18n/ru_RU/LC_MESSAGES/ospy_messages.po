msgstr "Пример: локальный хост."

#: plugins/mqtt_home_assistant/templates/mqtt_home_assistant.html:145
msgid "Range for port is 80 to 65535. Default: 1883."
msgstr "Диапазон портов: от 80 до 65535. По умолчанию: 1883."

#: plugins/mqtt_home_assistant/templates/mqtt_home_assistant.html:161
