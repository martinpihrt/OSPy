#: plugins/email_notifications_ssl/__init__.py:342
#: plugins/lcd_display/templates/lcd_display.html:372
#: plugins/lcd_display/templates/lcd_display_help.html:48
msgid "Sensors"
msgstr "Датчики"

#: ospy/options.py:398
#| msgid "DS18B20 error timeout"
msgid "Sensor HTTP timeout"
msgstr "Тайм-аут HTTP датчика"

#: ospy/options.py:400
msgid "Timeout in seconds for HTTP requests sent from OSPy to sensors."
msgstr "Тайм-аут в секундах для HTTP-запросов, отправленных из OSPy на датчики."

#: ospy/options.py:409
msgid "Maximum usage"
msgstr "Максимальное использование"

#: ospy/options.py:411
msgid ""
"Determines how station runs are combined. 0 means no limit. 1 means one station "
"at a time when each station has usage 1. This also affects when the pause "
"between stations is inserted."
msgstr ""
"Определяет, как объединяются маршруты станций. 0 означает отсутствие лимита. 1 "
"означает одну станцию одновременно, когда каждая станция использует 1. Это "
"также влияет на момент вставки паузы между станциями."

#: ospy/options.py:412 ospy/options.py:419 ospy/options.py:428 ospy/options.py:437
msgid "Station Handling"
msgstr "Обработка станции"

#: ospy/options.py:416
msgid "Number of outputs"
msgstr "Количество выходов"

#: ospy/options.py:418
msgid "The number of outputs available (8 + 8*extensions)"
msgstr "Количество доступных выходов (8 + 8*расширений)"

#: ospy/options.py:425
msgid "Pause between stations"
msgstr "Пауза между станциями"

#: ospy/options.py:427
msgid ""
"Pause inserted between sequential station runs when the scheduler cannot run "
"them at the same time, in seconds between 0 and 3600. This does not shift a "
"station against the master station. Example: with maximum usage 1 and station "
"usage 1, value 30 starts the next station 30 seconds after the previous station "
"ends."
msgstr ""
"Пауза, вставленная между последовательными заездами станций, когда планировщик "
"не может запустить их одновременно, в секундах между 0 и 3600. Это не смещает "
"станцию против главной станции. Пример: при максимальном использовании 1 и "
"использовании станции 1, значение 30 начинает следующую станцию через 30 секунд "
"после окончания предыдущей станции."

#: ospy/options.py:434
msgid "Minimum runtime"
msgstr "Минимальное время работы"

#: ospy/options.py:436
msgid ""
"Skip the pause between stations when the previous run was shorter than this "
"value, in seconds between 0 and 86400. Example: with pause 30 and minimum "
"runtime 10, a station that ran only 5 seconds will not force the 30 second "
"pause."
msgstr ""
"Пропускайте паузу между станциями, когда предыдущий забег был короче этого "
"значения — в секундах между 0 и 86400. Пример: при паузе 30 и минимальном "
"времени работы 10, станция, работающая всего 5 секунд, не заставит паузу на 30 "
"секунд."

#: ospy/options.py:445
msgid "Activate relay"
msgstr "Активировать реле"

#: ospy/options.py:447
msgid "Also activate the relay as master output."
msgstr "Также активируйте реле как главный выход."

#: ospy/options.py:448 ospy/options.py:455 ospy/options.py:464 ospy/options.py:473
#: ospy/options.py:482
msgid "Configure Master"
msgstr "Настроить Мастер"

#: ospy/options.py:452
msgid "Master start offset"
msgstr "Смещение главного старта"

#: ospy/options.py:454
msgid ""
"Time offset for starting master station 1 relative to the station start, in "
"seconds between -1800 and +1800. Negative values start the master earlier; "
"positive values start it later. Example: -10 starts the master 10 seconds "
"before the station, +10 starts it 10 seconds after the station."
msgstr ""
"Смещение времени для запуска главной станции 1 относительно старта станции в "
"секундах между -1800 и +1800. Отрицательные значения начинают мастер раньше; "
"Позитивные ценности начинают позже. Пример: -10 запускает мастер за 10 секунд "
"до станции, +10 запускает его через 10 секунд после станции."

#: ospy/options.py:461
msgid "Master stop offset"
msgstr "Смещение мастер-стопа"

#: ospy/options.py:463
msgid ""
"Time offset for stopping master station 1 relative to the station end, in "
"seconds between -1800 and +1800. Negative values stop the master earlier; "
"positive values keep it running longer. Example: -5 stops the master 5 seconds "
"before the station ends, +20 stops it 20 seconds after the station ends."
msgstr ""
"Смещение времени для остановки главной станции 1 относительно конца станции в "
"секундах между -1800 и +1800. Отрицательные значения останавливают мастер "
"раньше; Положительные ценности поддерживают его дольше. Пример: -5 "
"останавливает мастер за 5 секунд до окончания станции, +20 — через 20 секунд "
"после окончания станции."

#: ospy/options.py:470
msgid "Master two start offset"
msgstr "???????? ??????? ??????? ??????? 2"

#: ospy/options.py:472
msgid ""
"Time offset for starting master station 2 relative to the station start, in "
"seconds between -1800 and +1800. Negative values start the master earlier; "
"positive values start it later. Example: -10 starts master 2 10 seconds before "
"the station, +10 starts it 10 seconds after the station."
msgstr ""
"Смещение времени для старта главной станции 2 относительно старта станции "
"составляет секунды от -1800 до +1800. Отрицательные значения начинают мастер "
"раньше; Позитивные ценности начинают позже. Пример: -10 запускает мастер 2 за "
"10 секунд до станции, +10 запускает его через 10 секунд после станции."

#: ospy/options.py:479
msgid "Master two stop offset"
msgstr "???????? ????????? ??????? ??????? 2"

#: ospy/options.py:481
msgid ""
"Time offset for stopping master station 2 relative to the station end, in "
"seconds between -1800 and +1800. Negative values stop the master earlier; "
"positive values keep it running longer. Example: -5 stops master 2 5 seconds "
"before the station ends, +20 stops it 20 seconds after the station ends."
msgstr ""
"Смещение времени для остановки главной станции 2 относительно конца станции в "
"секундах между -1800 и +1800. Отрицательные значения останавливают мастер "
"раньше; Положительные ценности поддерживают его дольше. Пример: -5 остановок "
"мастера за 25 секунд до окончания станции, +20 останавливается через 20 секунд "
"после окончания станции."

#: ospy/options.py:490
