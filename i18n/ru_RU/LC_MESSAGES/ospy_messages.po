msgid "Security HTTP headers"
msgstr "Заголовки HTTP безопасности"

#: ospy/webpages.py:3937
msgid "OSPy does not add the complete recommended security header set globally."
msgstr "OSPy не добавляет полный рекомендуемый набор заголовков безопасности глобально."

